---
import { getCollection } from "astro:content";
import { climateLabel, unitMonthly } from "../lib/facts";
import { href } from "../lib/paths";
import { climateSortValue, sizeSqft, textSortValue, unitPriceSort } from "../lib/sort-keys.mjs";
import CheckedNote from "./CheckedNote.astro";
import StatusPill from "./StatusPill.astro";
import SourceCite from "./SourceCite.astro";

interface Props {
  climate?: "yes" | "no" | "unknown" | "any";
  sizes?: string;
  caption?: string;
  cityId?: string;
}
const { climate = "any", sizes = "", caption, cityId = "college-station" } = Astro.props;
const wanted = sizes
  .split(",")
  .map((size) => size.trim())
  .filter(Boolean);
const providers = (await getCollection("providers")).filter(
  (provider) => provider.data.kind === "self-storage" && provider.data.cities.includes(cityId),
);

const rows = providers.flatMap((provider) =>
  provider.data.units
    .filter((unit) => {
      if (wanted.length && !wanted.includes(unit.size)) return false;
      if (climate === "yes") return unit.climate === true;
      if (climate === "no") return unit.climate === false;
      if (climate === "unknown") return unit.climate === null;
      return true;
    })
    .map((unit) => ({ provider, unit })),
);
---

{
  rows.length === 0 ? (
    <p class="notice">No rooms in this list match. Ask the place, or look at another size.</p>
  ) : (
    <div class="table-scroll">
      <CheckedNote />
      <table data-sortable="true">
        <caption>{caption || "Published storage unit prices"}</caption>
        <thead>
          <tr>
            <th scope="col" aria-sort="none">
              <button type="button" class="sort-button" data-sort="location" data-sort-name="street address">
                Facility
              </button>
            </th>
            <th scope="col" aria-sort="none">
              <button type="button" class="sort-button" data-sort="size" data-sort-name="unit size">
                Size
              </button>
            </th>
            <th scope="col" aria-sort="none">
              <button type="button" class="sort-button" data-sort="climate" data-sort-name="climate control">
                Climate
              </button>
            </th>
            <th scope="col" aria-sort="none">
              <button type="button" class="sort-button" data-sort="price" data-sort-name="price">
                Price
              </button>
            </th>
            <th scope="col">Status</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ provider, unit }, index) => {
            const price = unitPriceSort(unit);
            const area = sizeSqft(unit.size);
            const climateSort = climateSortValue(unit.climate);
            const location = textSortValue(provider.data.address);
            return (
              <tr
                data-original={index}
                data-price={price.missing ? undefined : String(price.value)}
                data-price-missing={String(price.missing)}
                data-price-type="number"
                data-size={area == null ? undefined : String(area)}
                data-size-missing={String(area == null)}
                data-size-type="number"
                data-climate={climateSort.missing ? undefined : String(climateSort.value)}
                data-climate-missing={String(climateSort.missing)}
                data-climate-type="number"
                data-location={location.missing ? undefined : location.value}
                data-location-missing={String(location.missing)}
              >
                <th scope="row">
                  <a href={href(`/providers/${provider.id}`)}>{provider.data.name}</a>
                  <div class="small muted">{provider.data.address || "Address not yet verified"}</div>
                </th>
                <td>
                  {unit.size}
                  <div class="small muted">{unit.access}</div>
                  {unit.availability && <div class="small">{unit.availability}</div>}
                </td>
                <td>{climateLabel(unit.climate)}</td>
                <td>
                  {unitMonthly(unit)}
                  {unit.onlineMonthly != null && unit.inStoreMonthly != null && (
                    <div class="small muted">
                      Online {unitMonthly(unit, "onlineMonthly")}. In store {unitMonthly(unit, "inStoreMonthly")}.
                    </div>
                  )}
                  {unit.promo && <div class="small">{unit.promo}</div>}
                  {unit.note && <div class="small">{unit.note}</div>}
                </td>
                <td>
                  <StatusPill status={unit.status} />
                </td>
                <td>
                  <SourceCite href={unit.sourceUrl} label={unit.sourceLabel} lastVerified={unit.lastVerified} />
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="sort-note">
        Sort by price, size, climate, or street address. Facility uses the address, not miles from
        campus. Anything not listed stays at the bottom.
      </p>
    </div>
  )
}

<script>
  import { initSortableTables } from "../scripts/sort-table.mjs";
  initSortableTables();
</script>

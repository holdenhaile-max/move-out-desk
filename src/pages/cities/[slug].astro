---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import FaqList, { type FaqItem } from "../../components/FaqList.astro";
import UnitTable from "../../components/UnitTable.astro";
import { absoluteUrl, href } from "../../lib/paths";

export async function getStaticPaths() {
  const cities = await getCollection("cities");
  return cities.map((city) => ({ params: { slug: city.id }, props: { city } }));
}

const { city } = Astro.props;
const facilities = (await getCollection("providers"))
  .filter((provider) => provider.data.cities.includes(city.id) && provider.data.kind === "self-storage")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const lockPhone =
  facilities.find((facility) => facility.id === "lock-n-roll")?.data.phone || "(979) 693-7655";

const phoneAnswer = facilities
  .map((facility) => `${facility.data.name}: ${facility.data.phone || "not listed on the page"}`)
  .join(". ");

const askAnswer = facilities
  .map((facility) => `${facility.data.name}: ${facility.data.gaps.join(" ")}`)
  .join(" ");

const faqs: FaqItem[] = [
  {
    question: "What is climate controlled, and what is drive-up?",
    answer:
      `Climate controlled means the room is heated and cooled. Drive-up means you can park at the door. If a price says Not labeled, the listing does not say which kind of room it is. Ask before you book it. Lock N Roll is in the table. Their unit list adds $24 at move-in, and the company page says there is no admin fee beyond a small lock fee, so that charge is marked sources disagree. Checked Nov 21, 2026. Their hours are still not listed, so call ${lockPhone} before you plan to get in.`,
  },
  {
    question: "Can I trust a promo price for the whole summer?",
    answer:
      "Use the in-store or single monthly price unless the place locks the cheaper price in writing. CubeSmart on Manuel Drive shows a lower online price and a higher in-store price under first month free and 40% off, and does not say how many months that lasts. SpareBox prices are promotional, for new rentals, may not apply to every size, and rent can change with 30 days' notice. U-Haul at Texas Ave locks the monthly price for 12 months. Dowling Road offers 50% off the first month and does not print a price lock.",
  },
  {
    question: "What does Unverified mean?",
    answer:
      "Unverified means that number is not on the company page. It is left blank on purpose. Each listed price shows the day it was checked. Tap the source before you pay, because a price can change.",
  },
  {
    question: "What dates matter for a Texas A&M summer?",
    answer:
      "Collegeboxes lists pickups on December 11, 2026 and May 10, 2027. The same page says room pickup is currently unavailable. Checked Nov 20, 2026. Residence Life has not posted the Fall 2026 hall closing day. Call before you count on a date. A few weeks between leases, such as a TV and a dresser from July 31 to August 15, fits a month-to-month unit, not a 4-month pickup.",
    href: href("/guides/texas-am-dorm-move-out"),
    linkLabel: "Move-out dates",
  },
  {
    question: "How do roommates split a unit?",
    answer:
      "One person signs the lease. Checked Nov 21, 2026, a heated-and-cooled 5x10 at U-Haul Texas Ave was $99.95 a month, locked for 12 months, with a $0 move-in fee. Four months is $399.80, or $199.90 each for two people and $133.27 each for three, before tax. Put any unlisted move-in fee in the shared pot.",
    href: href("/guides/sharing-a-unit"),
    linkLabel: "Roommate split",
  },
  {
    question: "What if I was told Downing Road or All Seasons?",
    answer: city.data.regionNote,
  },
  {
    question: "What should I ask before I pay?",
    answer: askAnswer,
  },
  {
    question: "How do I call each place?",
    answer: `${phoneAnswer}.`,
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${city.data.name} storage prices`,
    itemListElement: facilities.map((facility, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: facility.data.name,
      url: absoluteUrl(`/providers/${facility.id}`),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.href ? `${item.answer} ${absoluteUrl("/guides/sharing-a-unit")}` : item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={`${city.data.name} storage prices`}
  description={`Sort ${city.data.name} storage by price, size, climate, or address. Each price shows the day it was checked.`}
  jsonLd={jsonLd}
>
  <p class="crumbs">
    <a href={href("/")}>Home</a> / <a href={href("/cities")}>Cities</a> / {city.data.name}
  </p>
  <h1>{city.data.name} storage prices</h1>
  <p class="lede">{city.data.summary} Sort by price, size, climate, or address.</p>
  <UnitTable cityId={city.id} caption={`${city.data.name} unit prices`} />
  <FaqList items={faqs} />
  <p class="prose">
    <a href={href("/guides/cheapest-storage-near-texas-am")}>Cheapest 5x5 and 5x10 prices</a>
    {" · "}
    <a href={href("/guides/college-station-climate-controlled")}>Heated and cooled rooms, compared</a>
    {" · "}
    <a href={href("/guides/dorm-unit-sizes")}>What size fits a dorm room</a>
  </p>
</BaseLayout>

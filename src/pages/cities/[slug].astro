---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import CheckedNote from "../../components/CheckedNote.astro";
import UnitTable from "../../components/UnitTable.astro";
import StatusPill from "../../components/StatusPill.astro";
import { kindLabel } from "../../lib/format";
import { absoluteUrl, href } from "../../lib/paths";

export async function getStaticPaths() {
  const cities = await getCollection("cities");
  return cities.map((city) => ({ params: { slug: city.id }, props: { city } }));
}

const { city } = Astro.props;
const facilities = (await getCollection("providers"))
  .filter((provider) => provider.data.cities.includes(city.id) && provider.data.kind === "self-storage")
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${city.data.name} self storage compared`,
  itemListElement: facilities.map((facility, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: facility.data.name,
    url: absoluteUrl(`/providers/${facility.id}`),
  })),
};
---

<BaseLayout
  title={`${city.data.name} storage units compared`}
  description={`Compare storage prices in ${city.data.name}. Sort by price, size, climate, or address, then call before you pay.`}
  jsonLd={jsonLd}
>
  <p class="crumbs">
    <a href={href("/")}>Home</a> / <a href={href("/cities")}>Cities</a> / {city.data.name}
  </p>
  <p class="eyebrow">{city.data.state}</p>
  <h1>{city.data.name} storage units</h1>
  <p class="lede">{city.data.summary}</p>
  <aside class="notice">
    <p>{city.data.regionNote}</p>
  </aside>

  <h2>Pick a place</h2>
  <p>Call or open the company page before you drive over. Climate controlled means the room is heated and cooled.</p>
  <CheckedNote />
  <div class="table-scroll">
    <table>
      <caption>{city.data.name} facilities in the comparison</caption>
      <thead>
        <tr>
          <th scope="col">Facility</th>
          <th scope="col">Address</th>
          <th scope="col">Published unit rows</th>
          <th scope="col">Phone</th>
        </tr>
      </thead>
      <tbody>
        {
          facilities.map((facility) => (
            <tr>
              <th scope="row">
                <a href={href(`/providers/${facility.id}`)}>{facility.data.name}</a>
                <div class="small muted">{kindLabel(facility.data.kind)}</div>
              </th>
              <td>{facility.data.address || "not yet verified"}</td>
              <td>{facility.data.units.length === 0 ? "Call for a price" : facility.data.units.length}</td>
              <td>{facility.data.phone || "Call the company page"}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Compare the prices</h2>
  <p>
    Drive-up means you can park at the door. If a price does not say whether the room is heated and
    cooled, it says Not labeled. Ask before you book that room. Lock N Roll is not in this table.
    Their page does not list a dollar price, so call (979) 693-7655.
  </p>
  <UnitTable cityId={city.id} caption={`All published unit rates for ${city.data.name}`} />

  <h2>What to ask each place</h2>
  {
    facilities.map((facility) => (
      <article>
        <h3>
          <a href={href(`/providers/${facility.id}`)}>{facility.data.name}</a>
        </h3>
        <ul class="clean">
          {facility.data.gaps.map((gap) => (
            <li>
              <StatusPill status="unverified" /> {gap}
            </li>
          ))}
        </ul>
      </article>
    ))
  }

  <p>
    The shorter climate comparison is the
    <a href={href("/guides/college-station-climate-controlled")}>heated-and-cooled unit guide</a>.
  </p>
</BaseLayout>

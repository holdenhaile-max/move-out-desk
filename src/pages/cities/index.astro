---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { href } from "../../lib/paths";

const cities = await getCollection("cities");
---

<BaseLayout
  title="Cities"
  description="Cities with a Storage Price Check comparison. College Station is the first, and Bryan is included when students ask about a place there."
>
  <p class="eyebrow">Directory</p>
  <h1>Cities</h1>
  <p class="lede">College Station is the city covered today, including Triangle Storage in Bryan.</p>
  <div class="card-grid two">
    {
      cities.map((city) => (
        <article class="card">
          <h2>
            <a href={href(`/cities/${city.id}`)}>
              {city.data.name}, {city.data.state}
            </a>
          </h2>
          <p>{city.data.summary}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import CheckedNote from "../components/CheckedNote.astro";
import { formatDate } from "../lib/format";
import { formatFeeAmount } from "../lib/facts";
import { absoluteUrl, href } from "../lib/paths";

const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
const featured = guides.filter((guide) => guide.data.featured);
const providers = await getCollection("providers");
const college = providers.find((item) => item.id === "collegeboxes");
const dorm = providers.find((item) => item.id === "dorm-room-movers");
const snapshot = [
  college?.data.fees.find((fee) => fee.id === "standard-box"),
  college?.data.fees.find((fee) => fee.id === "handling-tamu"),
  dorm?.data.fees.find((fee) => fee.id === "tier-box"),
  dorm?.data.fees.find((fee) => fee.id === "registration"),
].filter((fee) => fee != null);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Move-Out Desk",
  url: absoluteUrl("/"),
  description:
    "Independent comparison of Texas A&M summer storage: pickup, a local unit, or shipping home.",
  publisher: {
    "@type": "Organization",
    name: "Move-Out Desk",
    url: absoluteUrl("/"),
  },
};
---

<BaseLayout
  title="Texas A&M summer storage"
  description="Decide between a pickup, a College Station unit, or shipping home. Prices link to the company page."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div>
      <p class="eyebrow">Texas A&M</p>
      <h1>Where should your stuff go this summer?</h1>
      <p class="lede">
        You have three choices. A company picks the boxes up and brings them back. You rent a unit
        and haul it yourself. Or you ship it home. Pick from your car, your dates, and your budget.
      </p>
    </div>
    <aside class="notice">
      <p>
        <strong>Call Collegeboxes before you book a pickup.</strong> They list December 11, 2026 and
        May 10, 2027. The same page says room pickup is currently unavailable.
      </p>
      <p class="small">
        This is not Texas A&M. Collegeboxes says it has no active partnership with the university.
      </p>
    </aside>
  </section>

  <h2>Start with the decision you are making</h2>
  <div class="card-grid three">
    {
      featured.map((guide) => (
        <article class="card">
          <p class="eyebrow">{guide.data.eyebrow}</p>
          <h3>{guide.data.title}</h3>
          <p>{guide.data.description}</p>
          <a class="more" href={href(`/guides/${guide.id}`)}>
            Read the guide
          </a>
        </article>
      ))
    }
  </div>

  <h2>Prices to start from</h2>
  <p class="prose">
    These are not your final bill. The
    <a href={href("/guides/texas-am-summer-storage")}>summer storage guide</a> has a calculator with
    the same numbers.
  </p>
  <CheckedNote />
  <div class="table-scroll">
    <table>
      <caption>Starting prices for Texas A&M move-out</caption>
      <thead>
        <tr>
          <th scope="col">Item</th>
          <th scope="col">Published amount</th>
          <th scope="col">Checked</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {
          snapshot.map((fee) => (
            <tr>
              <th scope="row">{fee.label}</th>
              <td>{formatFeeAmount(fee)}</td>
              <td>
                <time datetime={fee.lastVerified}>{formatDate(fee.lastVerified)}</time>
              </td>
              <td>
                <a href={fee.sourceUrl}>{fee.sourceLabel}</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Two common situations</h2>
  <div class="card-grid two">
    <article class="card">
      <h3>Books and winter clothes for the summer</h3>
      <p>
        If you can drive, rent a heated and cooled room instead of hauling everything home. Compare
        the prices before you reserve.
      </p>
      <a href={href("/guides/college-station-climate-controlled")}>Heated and cooled units</a>
    </article>
    <article class="card">
      <h3>Only a few weeks between leases</h3>
      <p>
        A TV, a mini fridge, and a dresser between leases in College Station or Bryan fit a
        month-to-month unit. A 4-month pickup is the wrong product. Ask about the move-in fee. Several
        places do not list it.
      </p>
      <a href={href("/cities/college-station")}>College Station prices</a>
    </article>
  </div>
  <p class="small muted prose">
    Students asked about both of these. The threads are questions, not prices.
    <a href="https://www.reddit.com/r/aggies/comments/uil2rx/best_storage_units_in_cstat/">Summer storage thread</a>.
    <a href="https://www.reddit.com/r/aggies/comments/6meysf/wheres_can_i_find_the_cheapest_shortterm_storage/">Short-term storage thread</a>.
  </p>

  <p class="prose">
    <a href={href("/schools/texas-am")}>Texas A&M</a> ·
    <a href={href("/compare")}>Side by side</a> ·
    <a href={href("/about")}>About this guide</a>
  </p>
</BaseLayout>

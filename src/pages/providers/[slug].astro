---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import CheckedNote from "../../components/CheckedNote.astro";
import FeeTable from "../../components/FeeTable.astro";
import ProviderLink from "../../components/ProviderLink.astro";
import StatusPill from "../../components/StatusPill.astro";
import SourceCite from "../../components/SourceCite.astro";
import { climateLabel, unitMonthly } from "../../lib/facts";
import { climateSortValue, sizeSqft, unitPriceSort } from "../../lib/sort-keys.mjs";
import { kindLabel } from "../../lib/format";
import { href } from "../../lib/paths";

export async function getStaticPaths() {
  const providers = await getCollection("providers");
  return providers.map((provider) => ({ params: { slug: provider.id }, props: { provider } }));
}

const { provider } = Astro.props;
const data = provider.data;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": data.kind === "self-storage" ? "SelfStorage" : "Service",
  name: data.name,
  url: data.website,
  description: data.summary,
  telephone: data.phone || undefined,
  address: data.address || undefined,
};
---

<BaseLayout
  title={`${data.name} rates and gaps`}
  description={data.summary}
  jsonLd={jsonLd}
>
  <p class="crumbs">
    <a href={href("/")}>Home</a> / {data.name}
  </p>
  <p class="eyebrow">{kindLabel(data.kind)}</p>
  <h1>{data.name}</h1>
  <p class="lede">{data.summary}</p>
  <p>
    <ProviderLink name={data.name} website={data.website} affiliateUrl={data.affiliateUrl} label="Official page" />
    {data.phone && <span> · {data.phone}</span>}
  </p>
  {data.address && <p>{data.address}</p>}
  {
    data.affiliateUrl === null && (
      <p class="small muted">This link is not a paid ad.</p>
    )
  }

  <h2>Fees</h2>
  <FeeTable id={provider.id} />

  {
    data.units.length > 0 && (
      <>
        <h2>Units</h2>
        <div class="table-scroll">
          <table data-sortable="true">
            <caption>{data.name} unit prices</caption>
            <thead>
              <tr>
                <th scope="col" aria-sort="none">
                  <button type="button" class="sort-button" data-sort="size" data-sort-name="unit size">
                    Size
                  </button>
                </th>
                <th scope="col" aria-sort="none">
                  <button type="button" class="sort-button" data-sort="climate" data-sort-name="climate control">
                    Climate
                  </button>
                </th>
                <th scope="col" aria-sort="none">
                  <button type="button" class="sort-button" data-sort="price" data-sort-name="price">
                    Price
                  </button>
                </th>
                <th scope="col">Status</th>
                <th scope="col">Source</th>
              </tr>
            </thead>
            <tbody>
              {data.units.map((unit, index) => {
                const price = unitPriceSort(unit);
                const area = sizeSqft(unit.size);
                const climateSort = climateSortValue(unit.climate);
                return (
                  <tr
                    data-original={index}
                    data-price={price.missing ? undefined : String(price.value)}
                    data-price-missing={String(price.missing)}
                    data-price-type="number"
                    data-size={area == null ? undefined : String(area)}
                    data-size-missing={String(area == null)}
                    data-size-type="number"
                    data-climate={climateSort.missing ? undefined : String(climateSort.value)}
                    data-climate-missing={String(climateSort.missing)}
                    data-climate-type="number"
                  >
                    <th scope="row">
                      {unit.size}
                      <div class="small muted">{unit.access}</div>
                      {unit.availability && <div class="small">{unit.availability}</div>}
                    </th>
                    <td>{climateLabel(unit.climate)}</td>
                    <td>
                      {unitMonthly(unit)}
                      {unit.promo && <div class="small">{unit.promo}</div>}
                      {unit.note && <div class="small">{unit.note}</div>}
                    </td>
                    <td>
                      <StatusPill status={unit.status} />
                    </td>
                    <td>
                      <SourceCite href={unit.sourceUrl} label={unit.sourceLabel} lastVerified={unit.lastVerified} />
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <CheckedNote />
          <p class="sort-note">
            Sort by price, size, or climate. Climate controlled means the room is heated and cooled.
            Anything not listed stays at the bottom.
          </p>
        </div>
      </>
    )
  }

  <script>
    import { initSortableTables } from "../../scripts/sort-table.mjs";
    initSortableTables();
  </script>

  <h2>Other details</h2>
  <div class="table-scroll">
    <table>
      <caption>Details for {data.name}</caption>
      <thead>
        <tr>
          <th scope="col">Fact</th>
          <th scope="col">Detail</th>
          <th scope="col">Status</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {
          data.facts.map((fact) => (
            <tr>
              <th scope="row">{fact.label}</th>
              <td>
                {fact.value}
                {fact.note && <div class="small">{fact.note}</div>}
              </td>
              <td>
                <StatusPill status={fact.status} />
              </td>
              <td>
                <SourceCite href={fact.sourceUrl} label={fact.sourceLabel} lastVerified={fact.lastVerified} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section class="faq" aria-label="Ask before you pay">
    <h2>Ask before you pay</h2>
    <details class="faq-item">
      <summary>What is still missing</summary>
      <div class="faq-body">
        <ul class="clean">
          {data.gaps.map((gap) => <li>{gap}</li>)}
        </ul>
      </div>
    </details>
  </section>
</BaseLayout>

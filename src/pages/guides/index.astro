---
import { getCollection } from "astro:content";
import BaseLayout from "../../components/BaseLayout.astro";
import { formatDate } from "../../lib/format";
import { href } from "../../lib/paths";

const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Practical storage guides"
  description="Guides for Texas A&M move-out: pickup or a unit, heated and cooled rooms, and the Collegeboxes bill."
>
  <p class="eyebrow">Guides</p>
  <h1>Guides</h1>
  <p class="lede">
    Start with the choice you are making. The shorter guides are what to ask before you reserve,
    and how to split a unit with roommates.
  </p>
  <div class="card-grid two">
    {
      guides.map((guide) => (
        <article class="card">
          <p class="eyebrow">{guide.data.eyebrow}</p>
          <h2>
            <a href={href(`/guides/${guide.id}`)}>{guide.data.title}</a>
          </h2>
          <p>{guide.data.description}</p>
          <p class="small muted">Updated {formatDate(guide.data.updated)}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>

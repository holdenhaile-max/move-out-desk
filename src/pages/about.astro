---
import BaseLayout from "../components/BaseLayout.astro";
import { absoluteUrl, href } from "../lib/paths";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Storage Price Check",
  url: absoluteUrl("/about"),
  description:
    "How Storage Price Check checks Texas A&M storage prices, and the paid-link disclosure.",
  isPartOf: { "@type": "WebSite", name: "Storage Price Check", url: absoluteUrl("/") },
};
---

<BaseLayout
  title="About this guide"
  description="Storage Price Check is independent of Texas A&M and of the storage companies it lists. No links are paid. Here is how a price gets on the page."
  jsonLd={jsonLd}
>
  <p class="crumbs"><a href={href("/")}>Home</a> / About</p>
  <p class="eyebrow">About</p>
  <h1>A guide for your move-out, not an ad.</h1>
  <div class="prose stack">
    <p>
      Storage Price Check helps you choose summer storage at Texas A&M. It is not the university, not the dorms,
      and not Collegeboxes, Dorm Room Movers, U-Haul, CubeSmart, SpareBox, Anytime Storage, or Lock
      N Roll. Collegeboxes says it has no active partnership with Texas A&M University, College
      Station.
    </p>
    <h2>How we check prices</h2>
    <p>
      A price, date, fee, or hour is listed only when a public page states it. The row links that
      page and shows the day it was checked, in the form Checked Nov 19, 2026. That day is the day
      the number was read, not the day the site was built. If two official pages disagree, the row
      says sources disagree. If the number is not on the page, the row says Unverified. Nothing is
      filled in, and star ratings or student comments are not used as prices.
    </p>
    <h2>Paid links</h2>
    <p>
      No link on this site is paid, and no affiliate program has been joined. If that changes, the
      link will say Sponsored. Tap the company page before you pay. A price can change after the
      day shown on its row.
    </p>
    <h2>What you cannot do here</h2>
    <ul class="clean">
      <li>No accounts, no booking, and no payment.</li>
      <li>No ad trackers.</li>
    </ul>
  </div>
</BaseLayout>
